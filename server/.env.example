# Copy to server/.env and fill in. This file is committed; server/.env is not.

PORT=3001
MONGO_URI="mongodb://localhost:27017/cookbook"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=

# Account email (confirmation, password reset) through Resend. Without a key no
# email is sent; the operator can confirm an account with scripts/verify-account.js.
# Until the site has its own domain, EMAIL_FROM stays Resend's test sender, which
# delivers only to the Resend account's own inbox.
RESEND_API_KEY=
EMAIL_FROM="Proof <onboarding@resend.dev>"
# Where links in emails point. Defaults to the address the request came to.
PUBLIC_ORIGIN=

# The site operator's PIN: server backup, photo re-hosting, the pre-Phase-1
# library and the AI. Users' cookbooks never need it. Leave unset in local
# development to treat every caller as the operator.
ADMIN_PIN=
