# Copy to server/.env and fill in. This file is committed; server/.env is not.

PORT=3001
MONGO_URI="mongodb://localhost:27017/cookbook"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=

# Gate for every write/delete route. Leave unset to disable the gate entirely
# (every caller is treated as admin).
ADMIN_PIN=

# Serve the bundled sample recipes when MongoDB is unreachable, for demoing the app
# without a database. Off by default: without it, a missing database is reported as
# 503 rather than silently standing in fake recipes for real ones.
DEMO_MODE=false
